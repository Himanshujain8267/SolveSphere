PORT=4000
MONGODB_URL=mongodb://localhost:27017/solvesphere

# Firebase Admin SDK Configuration
# Get these values from Firebase Console > Project Settings > Service Accounts
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY=your-service-account-private-key-with-escaped-newlines
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxx%40your-project-id.iam.gserviceaccount.com

# Environment
NODE_ENV=development

# LeetCode API
LEETCODE_API_BASE_URL=https://alfa-leetcode-api.onrender.com

# Optional: Python interpreter used for recommendations and LPA demo estimates
# PYTHON_EXECUTABLE=C:\path\to\python.exe
